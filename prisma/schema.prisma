// filmDB data model — see ../PLAN.md for background.
//
// SQLite (no native enums), so category fields are strings constrained by the
// constants in src/lib/constants.ts:
//   Version.format:        BLURAY | DVD | HD | SD | UNKNOWN
//   Version.videoRange:    SDR | HDR10 | HLG | DOLBY_VISION
//   Film.matchConfidence:  EXACT | SEARCH | LOW | UNMATCHED
//   Album.kind:            STUDIO | COMPILATION | EP | LIVE | SINGLE | REMIX | SOUNDTRACK | OTHER
//   Album.coverSource:     embedded | itunes | discogs | manual
//   Track.codec:           alac | aac | mp3 | flac | drm | unknown
//   FilmPhysicalCopy.medium: DVD | BLURAY | UHD
//   Scene.matchConfidence: EXACT | SEARCH | LOW | UNMATCHED
//   ScanRun.kind: see the RunKind union in src/lib/runs.ts (source of truth — this
//     comment drifts, don't trust it)   ScanRun.status: RUNNING | DONE | FAILED

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A TMDB collection (James Bond, Alien, …). Films order by releaseDate for the
// timeline view; owned=false member Films are the "missing" entries.

model Collection {
  id           Int     @id // TMDB collection id
  name         String
  overview     String?
  posterPath   String?
  backdropPath String?
  films        Film[]
}

// One movie identity. Rows also exist for films we DON'T own (owned=false),
// created from TMDB collection membership — that's what the missing-films
// report is built from.

model Film {
  id              Int                @id @default(autoincrement())
  title           String
  sortTitle       String // normalised for sorting/grouping ("Matrix, The" style not needed — just lowercased, articles stripped)
  year            Int?
  imdbId          String?            @unique
  tmdbId          Int?               @unique
  overview        String?
  posterPath      String? // TMDB path; cached locally under /api/poster
  backdropPath    String?
  releaseDate     DateTime?
  runtimeMins     Int?
  rating          Float? // TMDB vote_average
  genres          String? // comma-separated
  owned           Boolean            @default(true)
  matchConfidence String             @default("UNMATCHED")
  collectionId    Int?
  collection      Collection?        @relation(fields: [collectionId], references: [id])
  versions        Version[]
  physicalCopies  FilmPhysicalCopy[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([collectionId])
  @@index([sortTitle])
  favourites   FilmFavourite[]
}

// A physical disc you own of this film — independent of digital ownership
// (Film.owned/versions). Presence of a row means "own on <medium>", full
// stop; the film may or may not also have a ripped Version. Mirrors
// PhysicalCopy below, one row per (film, medium).

model FilmPhysicalCopy {
  id      Int      @id @default(autoincrement())
  filmId  Int
  film    Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  medium  String // DVD | BLURAY | UHD (see Version.format vocabulary)
  barcode String?
  notes   String?
  addedAt DateTime @default(now())

  @@unique([filmId, medium])
  @@index([filmId])
  @@index([barcode])
}

// One file on disk. A film with a DVD rip and a BluRay rip (or theatrical +
// director's cut) has multiple Versions.

model Version {
  id           Int          @id @default(autoincrement())
  filmId       Int
  film         Film         @relation(fields: [filmId], references: [id], onDelete: Cascade)
  filePath     String       @unique // relative to MOVIES_PATH
  fileName     String
  edition      String? // "Theatrical Release", "2003 Directors Cut", "Extended Edition"…
  format       String       @default("UNKNOWN")
  width        Int?
  height       Int?
  videoCodec   String?
  videoRange   String? // SDR | HDR10 | HLG | DOLBY_VISION — null until probed
  container    String? // mkv, mp4…
  sizeBytes    BigInt?
  durationSecs Float?
  mtimeMs      Float? // probe cache key: re-probe only if mtime or size changed
  probedAt     DateTime?
  jellyfinId   String? // Jellyfin library item id (32-hex); set by the Jellyfin sync job
  audioTracks  AudioTrack[]
  watchProgress WatchProgress[]

  @@index([filmId])
}

model AudioTrack {
  id        Int     @id @default(autoincrement())
  versionId Int
  version   Version @relation(fields: [versionId], references: [id], onDelete: Cascade)
  streamIdx Int
  codec     String?
  profile   String? // e.g. "DTS-HD MA", "DTS", "DD+" — from ffprobe stream profile
  language  String?
  channels  Int?
  layout    String? // "5.1", "stereo"…
  title     String? // "Surround 5.1", "Director's Commentary"…
  // ffprobe stream dispositions (see ProbedAudioTrack in src/lib/ffprobe.ts):
  // the container's default-track flag, and whether this is an audio
  // description / commentary track. Rows probed before these existed are
  // false/false until the next forced scan.
  isDefault     Boolean @default(false)
  isDescriptive Boolean @default(false)

  @@index([versionId])
}

// --- TV ---
// Same philosophy as movies: rows exist for content we DON'T own
// (Episode.owned=false, created from TMDB season manifests) so the report
// can show missing seasons/episodes per show.

model Show {
  id              Int          @id @default(autoincrement())
  title           String
  sortTitle       String
  year            Int? // first-air year, filename-derived or TMDB
  folder          String       @unique // top-level folder under TVSHOWS_PATH
  tmdbId          Int?         @unique
  imdbId          String?      @unique
  overview        String?
  posterPath      String?
  backdropPath    String?
  firstAirDate    DateTime?
  status          String? // "Ended", "Returning Series", …
  rating          Float?
  genres          String?
  matchConfidence String       @default("UNMATCHED")
  seasons         ShowSeason[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([sortTitle])
}

model ShowSeason {
  id           Int       @id @default(autoincrement())
  showId       Int
  show         Show      @relation(fields: [showId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String?
  overview     String?
  posterPath   String?
  airDate      DateTime?
  episodes     Episode[]

  @@unique([showId, seasonNumber])
}

model Episode {
  id            Int           @id @default(autoincrement())
  seasonId      Int
  season        ShowSeason    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  name          String?
  overview      String?
  stillPath     String?
  airDate       DateTime?
  runtimeMins   Int?
  owned         Boolean       @default(false)
  files         EpisodeFile[]

  @@unique([seasonId, episodeNumber])
}

// One file on disk; a multi-episode file (S01E01-E02) links to each Episode
// it covers via its own row per episode sharing the same filePath — so
// filePath is NOT unique here, (filePath, episodeId) is.

model EpisodeFile {
  id           Int       @id @default(autoincrement())
  episodeId    Int
  episode      Episode   @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  filePath     String // relative to TVSHOWS_PATH
  fileName     String
  format       String    @default("UNKNOWN")
  width        Int?
  height       Int?
  videoCodec   String?
  videoRange   String?
  container    String?
  sizeBytes    BigInt?
  durationSecs Float?
  audioSummary String? // e.g. "DTS-HD MA 5.1 ENG; AC3 2.0 ENG"
  mtimeMs      Float?
  probedAt     DateTime?
  jellyfinId   String?
  watchProgress WatchProgress[]

  @@unique([filePath, episodeId])
  @@index([episodeId])
}

// Bookkeeping for scans and enrichment runs; log holds a JSON array of
// human-readable notes (unparsed files, low-confidence matches, errors).

model ScanRun {
  id         Int       @id @default(autoincrement())
  kind       String // SCAN | ENRICH | JELLYFIN | ENRICH_MUSIC
  status     String    @default("RUNNING")
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  filesSeen  Int       @default(0)
  progress   Int       @default(0)
  total      Int       @default(0)
  message    String?
  log        String? // JSON array of strings
}

// A barcode scanned via the /scan batch mode but not yet resolved to an
// added Film/Album — a persistent, cross-device worklist (deliberately NOT
// per-browser localStorage, so a phone scanning session is visible from any
// device). A row is deleted once its barcode is successfully added to the
// collection; it stays here while pending, unresolved ("unknown"), or
// wrong, so the user can retry or correct it later. See
// src/app/api/scan-queue for the CRUD + processing.

model ScanQueueItem {
  id           Int      @id @default(autoincrement())
  barcode      String   @unique
  mediaType    String   @default("auto") // auto | film | album
  status       String   @default("pending") // pending | looking_up | resolved | error
  resultJson   String? // serialized LookupResult, set once status=resolved
  errorMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// --- Music ---
// Same philosophy as movies/TV: Album rows exist for back-catalogue entries
// we DON'T own (owned=false), created from an artist's Discogs discography listing.

model Artist {
  id              Int      @id @default(autoincrement())
  name            String
  sortName        String
  folder          String?  @unique // top-level folder under MUSIC_PATH; null for vinyl-only artists with no digital rips
  discogsId       Int?     @unique // Discogs artist id
  disambiguation  String?
  various         Boolean  @default(false) // Compilations pseudo-artist
  matchConfidence String   @default("UNMATCHED") // EXACT | SEARCH | LOW | UNMATCHED
  studioTotal     Int? // count of "Main" studio releases Discogs lists for this artist, recorded even when gap tracking is off and no placeholders are created
  albums          Album[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Roon-style enrichment (see artist-bio.ts) — best-effort, multi-source,
  // cached like Album.coverPath. TheAudioDB/Fanart.tv were keyed by a
  // MusicBrainz artist id and no longer run post-Discogs-cutover (see
  // artist-bio.ts) — only the Wikipedia-by-name tier remains. Null simply
  // means "not fetched yet" or "no source had anything", same convention as
  // the rest of this app's enrichment fields — never blocks anything.
  bio            String? // biography text
  bioSource      String? // theaudiodb | wikipedia | manual
  photoPath      String? // cached portrait/thumb image, relative to POSTER_CACHE_DIR/artists/
  photoSource    String? // theaudiodb | fanart | wikipedia | manual
  backdropPath   String? // cached wide background/banner image, relative to POSTER_CACHE_DIR/artists/
  backdropSource String? // fanart | theaudiodb | manual

  @@index([sortName])
}

model Album {
  id             Int            @id @default(autoincrement())
  artistId       Int
  artist         Artist         @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title          String
  sortTitle      String
  year           Int?
  releaseDate    DateTime?
  // Exactly one of these two is ever meaningfully set — a Discogs master
  // groups every pressing/edition of a release (the closer analog to
  // MusicBrainz's old release-group identity); a standalone release (no
  // master — common for small-run/promo pressings) is its own identity
  // instead. Enforced in code (findAlbumByDiscogsIdentity), not the DB.
  discogsMasterId  Int?    @unique
  discogsReleaseId Int?    @unique
  // The literal discogs.com URL used for the current match — stored
  // verbatim (not reconstructed from the id above) so the edit UI can show
  // provenance and link straight back to it. Set by both automatic
  // enrichment and a manual "fix incorrect match" correction.
  discogsUrl       String?
  kind           String         @default("STUDIO") // STUDIO | COMPILATION | EP | LIVE | SINGLE | REMIX | SOUNDTRACK | OTHER
  coverPath      String? // cached cover art file name under the cover cache dir
  coverSource    String? // embedded | itunes | discogs | manual — provenance of coverPath; "manual" is never overwritten
  owned          Boolean        @default(true)
  folder         String? // album folder name under the artist folder (null when owned=false)
  digitalSource  String? // provenance of the digital files: cd | itunes | download | vinyl-code (bundled with the LP); null = unconfirmed
  trackTotal     Int? // canonical track count from Discogs, if known
  tracks         Track[]
  physicalCopies PhysicalCopy[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([artistId, folder])
  @@index([artistId])
}

// A physical copy you own of this album — independent of digital ownership
// (Album.owned). Presence of a row means "own on <medium>", full stop; the
// album may or may not also have digital Tracks. Multiple rows for the same
// (album, medium) are legal — e.g. an original CD-era pressing and a later
// anniversary vinyl reissue — distinguished in the UI by format/label/
// pressYear/notes and ordered by addedAt; there is no "primary" copy.

model PhysicalCopy {
  id        Int      @id @default(autoincrement())
  albumId   Int
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)
  medium    String // CD | VINYL (extensible: CASSETTE, SACD, ...)
  format    String // per-medium: LP | 2xLP | 7" | BOX... / CD | 2xCD...
  inferred  Boolean  @default(false) // true for backfilled CD rows not yet confirmed by hand
  discs     Int? // explicit disc count when the format string doesn't say (BOX sets)
  catalogNo String?
  label     String? // pressing label/imprint, can differ from the original
  pressYear Int? // pressing year — often later than Album.year for reissues
  speedRpm  String? // e.g. "45 RPM" — vinyl only. Discogs only states this for
                     // non-default/special-case pressings (see
                     // fetchDiscogsRelease), so null here just means "assume
                     // standard speed for the format," not "unknown."
  condition String? // free text ("VG+", "Sealed", ...)
  notes     String?
  barcode   String? // the barcode scanned to identify THIS specific pressing — a CD and an LP of
                     // the same album carry different barcodes, so this stays per-copy, not on Album
  addedAt   DateTime @default(now())

  // The specific Discogs *release* (a particular pressing) this copy
  // corresponds to — distinct from Album.discogsMasterId/discogsReleaseId,
  // which identify the abstract work. A pressing can have its own tracklist
  // and cover art (an LP with a different running order/art than the CD),
  // which is why these live per-PhysicalCopy rather than on Album. Null
  // until the owner links a specific release (see attachPhysicalRelease in
  // discogs.ts) — metadata-only copies work fine without it.
  discogsReleaseId Int?
  // The literal discogs.com/release/... URL used for this pressing link —
  // stored verbatim, same provenance treatment as Album.discogsUrl.
  discogsUrl  String?
  coverPath   String? // cached cover art specific to this pressing, relative to POSTER_CACHE_DIR/covers/
  coverSource String? // discogs | manual — "manual" is never overwritten, same convention as Album.coverSource
  tracks      PhysicalTrack[]

  @@index([albumId, medium])
  @@index([barcode])
}

// A pressing-specific tracklist, populated from a Discogs release (see
// PhysicalCopy.discogsReleaseId) — never backed by a file, unlike Track. Only
// exists when the owner has linked a specific release; most PhysicalCopy
// rows have none.
model PhysicalTrack {
  id             Int          @id @default(autoincrement())
  physicalCopyId Int
  physicalCopy   PhysicalCopy @relation(fields: [physicalCopyId], references: [id], onDelete: Cascade)
  disc           Int          @default(1)
  trackNumber    Int?
  title          String
  durationSecs   Float?

  @@index([physicalCopyId])
}

model Track {
  id           Int       @id @default(autoincrement())
  albumId      Int
  album        Album     @relation(fields: [albumId], references: [id], onDelete: Cascade)
  disc         Int       @default(1)
  trackNumber  Int?
  title        String
  filePath     String    @unique // relative to MUSIC_PATH
  fileName     String
  codec        String? // alac | aac | mp3 | flac | drm | unknown
  lossless     Boolean   @default(false)
  sampleRate   Int?
  bitDepth     Int?
  durationSecs Float?
  sizeBytes    BigInt?
  tagYear      Int? // year from the file's own date tag — Album.year fallback when Discogs has no match
  mtimeMs      Float? // probe cache key, same convention as Version
  probedAt     DateTime?

  @@index([albumId])
}

// --- Adult ---
// One flat model per scene, unlike Film/Version — confirmed one file per
// scene (no multi-edition case) and no "owned but not on disk" placeholder
// need (no missing-content report for this media type), so there's no
// reason to split identity from file the way Film/Version does.

model Scene {
  id              Int              @id @default(autoincrement())
  title           String
  sortTitle       String
  studioId        Int?
  studio          Studio?          @relation(fields: [studioId], references: [id])
  date            DateTime?
  overview        String?
  posterPath      String?
  backgroundPath  String?
  tpdbId          String?          @unique // ThePornDB scene UUID (its "id" field, not "_id")
  matchConfidence String           @default("UNMATCHED")
  performers      ScenePerformer[]

  // File fields — same probe-cache shape as Version.
  filePath     String     @unique // relative to ADULT_PATH
  fileName     String
  folder       String? // immediate parent dir name (studio hint) — display/matching hint only, never authoritative
  format       String     @default("UNKNOWN")
  width        Int?
  height       Int?
  videoCodec   String?
  videoRange   String?
  container    String?
  sizeBytes    BigInt?
  durationSecs Float?
  mtimeMs      Float?
  probedAt     DateTime?

  jellyfinId String? // Jellyfin library item id (32-hex); set by the Jellyfin sync job

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studioId])
  @@index([sortTitle])
}

model Performer {
  id        Int              @id @default(autoincrement())
  name      String
  tpdbId    String?          @unique
  imagePath String?
  scenes    ScenePerformer[]

  @@index([name])
}

model Studio {
  id     Int     @id @default(autoincrement())
  name   String
  tpdbId Int?    @unique // Site.id is an int, unlike Scene/Performer's UUID
  scenes Scene[]

  @@index([name])
}

// Explicit join model (not Prisma implicit M2M), matching this schema's
// OauthClientResource convention.
model ScenePerformer {
  id          Int       @id @default(autoincrement())
  sceneId     Int
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  performerId Int
  performer   Performer @relation(fields: [performerId], references: [id], onDelete: Cascade)

  @@unique([sceneId, performerId])
  @@index([sceneId])
  @@index([performerId])
}

// --- Auth (BetterAuth) ---
// Generated by `npx @better-auth/cli generate` against src/lib/auth.ts.
// User/Session/Account/Verification are the core models (Phase 1); the
// organization plugin (Phase 3) added Household/Member/Invitation and
// Session.activeHouseholdId, remapped from the plugin's generic
// organization/member/invitation naming to match this app's own domain
// language (see HOUSEHOLDS_PLAN.md). @@map keeps BetterAuth's own table-name
// convention rather than this schema's model names leaking into the
// physical tables.

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  members     Member[]
  invitations Invitation[]

  // Runs the app (sees /admin, mints access codes, reads the audit log).
  // Deliberately separate from Member.role's "owner"/"member" — that's
  // per-household, this is app-wide and normally true for exactly one user.
  // See src/lib/require-member.ts.
  isAppOwner Boolean @default(false)

  // Self-service opt-in gating the Adult media type — see /account and
  // src/lib/jellyfin.ts's syncJellyfinAdultAccess. jellyfinUserId is
  // resolved+cached the first time a sync succeeds; null until this
  // person's first Jellyfin SSO login (jellyfin-plugin-sso creates their
  // Jellyfin account lazily, on first sign-in, not before).
  adultLibraryAccess Boolean @default(false)
  jellyfinUserId     String?

  oauthclients       OauthClient[]
  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]
  oauthconsents      OauthConsent[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeHouseholdId String?

  oauthrefreshtokens OauthRefreshToken[]
  oauthaccesstokens  OauthAccessToken[]

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Passkeys — see PASSKEYS_PLAN.md. One row per registered authenticator (a
// phone, a laptop, a security key), owned by @better-auth/passkey: the
// column set is exactly what that plugin's schema declares, nothing
// app-specific added. onDelete: Cascade is load-bearing — deleteAccount
// (src/app/actions/account.ts) does a plain prisma.user.delete and relies
// on the schema's cascades, so without it a deleted user would leave
// orphan credentials behind.
model Passkey {
  id           String   @id
  name         String?
  publicKey    String
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime @default(now())
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// Access codes — the growth/trust gate for brand-new households (see
// HOUSEHOLDS_PLAN.md "Access codes & the web of trust"). Ported from
// jinglejotter.com's AccessCode model, simplified: this app has no
// monetization, so the `kind`/`accessExpiresAt` trial-vs-lifetime pair is
// dropped entirely. Minted by scripts/gen-access-code.ts, redeemed inside
// Phase 4's createHousehold action via src/lib/access.ts's claimAccessCode.

model AccessCode {
  id              String    @id @default(cuid())
  code            String    @unique // canonical form: MV + 8 chars, no 0/O/1/I/L
  email           String? // null = claimable by anyone signed in; set = bound to one address
  note            String? // admin-only: who/what this code was minted for
  // When the invite email carrying this code was last sent (admin page's
  // "send"/"resend"). Null = minted but never emailed.
  sentAt          DateTime?
  maxRedemptions  Int       @default(1)
  redeemedCount   Int       @default(0)
  redeemableUntil DateTime?
  createdAt       DateTime  @default(now())
}

// Who-did-what metadata for the admin page — deliberately CONTENT-FREE:
// action names and ids only, never titles/names/amounts, so the app owner
// can see how households use the app without seeing what's actually stored
// in it. No FK relations: audit rows must survive their user/household being
// deleted (the admin page renders "(deleted)" instead).
model AuditLog {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  userId      String?
  householdId String?
  action      String // "<entity>.<verb>", e.g. "household.create"
  entityId    String?

  @@index([createdAt])
}

// Per-user resume position + basic play stats (HOUSEHOLDS_PLAN.md's "Watch
// history & stats", Phase 7). Films and TV episodes don't share an id space
// (Version vs EpisodeFile are separate tables), so exactly one of
// versionId/episodeFileId is set per row — enforced at the app level, same
// as SQLite's general lack of CHECK-constraint support elsewhere in this
// schema.
//
// Scope note (see HOUSEHOLDS_PLAN.md): in-app playback only exists for
// films today (VideoPlayer.tsx / the Version path) — TV episode playback
// isn't built anywhere in this app. episodeFileId stays here, unwired,
// purely as schema future-proofing for when TV playback exists; nothing in
// this phase reads or writes it.
// A person's favourite films (the heart on the film page). Per user, not
// per household, like WatchProgress.
model FilmFavourite {
  userId    String // BetterAuth User.id
  filmId    Int
  film      Film     @relation(fields: [filmId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, filmId])
  @@index([userId])
}

model WatchProgress {
  id            Int          @id @default(autoincrement())
  userId        String // BetterAuth User.id
  versionId     Int?
  version       Version?     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  episodeFileId Int?
  episodeFile   EpisodeFile? @relation(fields: [episodeFileId], references: [id], onDelete: Cascade)
  positionSecs  Float
  completed     Boolean      @default(false)
  playCount     Int          @default(0)
  updatedAt     DateTime     @updatedAt

  @@unique([userId, versionId])
  @@unique([userId, episodeFileId])
  @@index([userId])
}

model Household {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]

  @@unique([slug])
  @@map("Household")
}

model Member {
  id          String    @id
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member")
  createdAt   DateTime

  @@index([householdId])
  @@index([userId])
  @@map("Member")
}

model Invitation {
  id          String    @id
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  email       String
  role        String?
  status      String    @default("pending")
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  inviterId   String
  user        User      @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([householdId])
  @@index([email])
  @@map("Invitation")
}

model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

model OauthClient {
  id                               String                @id
  clientId                         String
  clientSecret                     String?
  clientDiscoveryId                String?
  disabled                         Boolean?              @default(false)
  skipConsent                      Boolean?
  enableEndSession                 Boolean?
  subjectType                      String?
  scopes                           String?
  clientCredentialsScopes          String?
  userId                           String?
  user                             User?                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt                        DateTime?
  updatedAt                        DateTime?
  name                             String?
  uri                              String?
  icon                             String?
  contacts                         String?
  tos                              String?
  policy                           String?
  softwareId                       String?
  softwareVersion                  String?
  softwareStatement                String?
  redirectUris                     String
  postLogoutRedirectUris           String?
  backchannelLogoutUri             String?
  backchannelLogoutSessionRequired Boolean?
  tokenEndpointAuthMethod          String?
  applicationType                  String?
  jwks                             String?
  jwksUri                          String?
  grantTypes                       String?
  responseTypes                    String?
  requirePKCE                      Boolean?
  dpopBoundAccessTokens            Boolean?              @default(false)
  referenceId                      String?
  metadata                         String?
  oauthclientresources             OauthClientResource[]
  oauthrefreshtokens               OauthRefreshToken[]
  oauthaccesstokens                OauthAccessToken[]
  oauthconsents                    OauthConsent[]

  @@unique([clientId])
  @@index([userId])
  @@map("oauthClient")
}

model OauthResource {
  id                            String                @id
  identifier                    String
  name                          String
  accessTokenTtl                Int?
  refreshTokenTtl               Int?
  signingAlgorithm              String?
  signingKeyId                  String?
  allowedScopes                 String?
  customClaims                  String?
  dpopBoundAccessTokensRequired Boolean?              @default(false)
  disabled                      Boolean?              @default(false)
  createdAt                     DateTime?
  updatedAt                     DateTime?
  policyVersion                 Int?                  @default(1)
  metadata                      String?
  oauthclientresources          OauthClientResource[]

  @@unique([identifier])
  @@map("oauthResource")
}

model OauthClientResource {
  id            String        @id
  clientId      String
  oauthclient   OauthClient   @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  resourceId    String
  oauthresource OauthResource @relation(fields: [resourceId], references: [identifier], onDelete: Cascade)
  metadata      String?
  createdAt     DateTime?

  @@index([clientId])
  @@index([resourceId])
  @@map("oauthClientResource")
}

model OauthRefreshToken {
  id                      String             @id
  token                   String
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String
  user                    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String?
  requestedUserInfoClaims String?
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  rotatedAt               DateTime?
  rotationReplayResponse  String?
  rotationReplayExpiresAt DateTime?
  authTime                DateTime?
  confirmation            String?
  scopes                  String
  oauthaccesstokens       OauthAccessToken[]

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id                      String             @id
  token                   String?
  clientId                String
  oauthclient             OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  sessionId               String?
  session                 Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  userId                  String?
  user                    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  authorizationCodeId     String?
  resources               String?
  requestedUserInfoClaims String?
  refreshId               String?
  oauthrefreshtoken       OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)
  expiresAt               DateTime?
  createdAt               DateTime?
  revoked                 DateTime?
  confirmation            String?
  scopes                  String

  @@unique([token])
  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([authorizationCodeId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id                      String      @id
  clientId                String
  oauthclient             OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                  String?
  user                    User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  referenceId             String?
  resources               String?
  requestedUserInfoClaims String?
  scopes                  String
  createdAt               DateTime?
  updatedAt               DateTime?

  @@index([clientId])
  @@index([userId])
  @@map("oauthConsent")
}

model OauthClientAssertion {
  id        String   @id
  expiresAt DateTime

  @@map("oauthClientAssertion")
}
